# LLM
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=brage-ai-hub

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Ollama (local privacy mode)
OLLAMA_BASE_URL=http://ollama:11434
PRIVACY_MODE=false

# Services
EMPLOYEE_ID=marketing-manager
CONFIG_API_URL=http://config-api:8090
HYBRID_ROUTER_URL=http://hybrid-router:9000
FRONTEND_URL=http://localhost:3001  # dev branch — use 3000 for main

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Gmail
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Soniox (real-time transcription)
SONIOX_API_KEY=your-soniox-api-key

# GitHub MCP server (for Developer employee)
GITHUB_TOKEN=
