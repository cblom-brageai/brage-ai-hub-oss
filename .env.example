# Copy to .env and fill in what you use. Never commit .env.
# docker/Makefile passes this file to every compose stack; the Chrome extension build reads it too.

# ── Company (shown to the agents and the onboarding assistant) ───────────────
COMPANY_NAME=Example Energy
COMPANY_DESCRIPTION=a renewable energy company

# ── LLM provider ─────────────────────────────────────────────────────────────
# Model ids: gemini-* (Google), claude-* (Anthropic), gpt-*/o* (OpenAI), ollama/<model> (local).
# Only the provider you use needs a key. Per-employee overrides live in agent.config.md.
DEFAULT_LLM=gemini-3-flash-preview
REASONING_LLM=gemini-3.1-pro-preview
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Privacy mode (local models only) ─────────────────────────────────────────
# PRIVACY_MODE=true routes every model call to Ollama. Start the stack with --profile privacy.
PRIVACY_MODE=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ── Supabase (database, artefact storage, realtime) ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=brage-ai-hub

# ── Slack (optional) ─────────────────────────────────────────────────────────
# Socket Mode: bot token (xoxb-…) + app-level token (xapp-…). See docs/employees.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── Meetings (optional) ──────────────────────────────────────────────────────
# Soniox real-time transcription key used by the Chrome extension via the hub.
SONIOX_API_KEY=
# Hub URL baked into the Chrome extension build (apps/chrome-extension/vite.config.ts)
FRONTEND_URL=http://localhost:3000

# ── Developer employee (optional) ────────────────────────────────────────────
# Fine-grained GitHub token for the GitHub MCP server container.
GITHUB_TOKEN=

# ── Config API ───────────────────────────────────────────────────────────────
GIT_ENABLED=false
GIT_AUTHOR_EMAIL=config-api@example.com
